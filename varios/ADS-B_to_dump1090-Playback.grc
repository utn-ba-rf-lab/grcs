options:
  parameters:
    author: mdoallo
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Este diagrama se complementa con RTL_ADS-B_to_dump1090.grc\nReproduce\
      \ lo que grab\xF3 RTL_ADS-B_to_dump1090.grc\nLa entrada es un archivo wav de\
      \ dos canales de 2 MSps\n\nAntes de correr este grc:\n1. Ejecutar \"tail -f\
      \ /home/mdoallo/Descargas/datos.dat\"\n2. Correr \"RTL_ADS-B_to_dump1090.grc\"\
      \n3. Detener \"RTL_ADS-B_to_dump1090.grc\"\n4. Ejecutar \"./dump1090 --ifile\
      \ /home/mdoallo/Descargas/datos.dat --net --metric\"\n5. Correr \"ADS-B_to_dump1090-Playback.grc\"\
      \n6. Detener \"tail -f /home/mdoallo/Descargas/datos.dat\"\n7. Ajustar la Ganancia\
      \ convenientemente\n8. http://127.0.0.1:8080/"
    copyright: ''
    description: Playback de mensajes ADS-B
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: to_dump1090
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ADS-B
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16.0]
    rotation: 0
    state: enabled

